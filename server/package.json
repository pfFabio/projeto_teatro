{
  "name": "theatrum-server",
  "version": "1.0.0",
  "description": "API REST do Theatrum",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "node -e \"const fs=require('fs'); const url=process.env.DATABASE_URL||''; if(url.startsWith('postgres')){ let s=fs.readFileSync('prisma/schema.prisma','utf8'); fs.writeFileSync('prisma/schema.prisma', s.replace(/provider = \\\"sqlite\\\"/, 'provider = \\\"postgresql\\\"')); }\" && npx prisma generate && npx prisma db push",
    "seed": "node prisma/seed.js",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "test": "jest --verbose"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "prisma": "^6.5.0",
    "supertest": "^7.2.2"
  }
}
