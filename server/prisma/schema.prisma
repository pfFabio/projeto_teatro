// =============================================================================
// Theatrum — Schema do Banco de Dados (Prisma)
// Projeto acadêmico de gestão de peças de teatro
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL em produção (Supabase / Render) — SQLite em dev local
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Usuário administrador do sistema
// =============================================================================
model Usuario {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  senha               String    // Hash bcrypt
  nome                String
  papel               String    @default("ADMIN") // Apenas ADMIN por enquanto
  resetToken          String?   // Token para recuperação de senha
  resetTokenValidade  DateTime? // Expiração do token de recuperação
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @default(now()) @updatedAt

  @@map("usuarios")
}

// =============================================================================
// Colaborador — Ator, técnico, ou qualquer pessoa envolvida nas peças
// Cadastrado via formulário público ou pelo admin (com proteção LGPD)
// =============================================================================
model Colaborador {
  id               Int       @id @default(autoincrement())
  nome             String
  nomeArtistico    String?
  funcao           String    // Ator, Diretor, Técnico de Som, etc.
  idade            Int?      @default(0)
  celular          String
  email            String    @unique
  endereco         String
  genero           String    // Masculino, Feminino, Não-binário, Prefiro não dizer
  fotoUrl          String?   // Caminho da foto enviada
  dataNascimento   String?   // DD/MM/AAAA ou YYYY-MM-DD
  etniaRaca        String?   // Branco, Preto, Pardo, Amarelo, Indígena, etc.
  orientacaoSexual String?   // Cisgênero, Transgênero, Heterossexual, etc.
  cpf              String?   // Dado sensível (visível apenas para admin)
  rg               String?   // Dado sensível (visível apenas para admin)
  drtOmb           String?
  redeSocial       String?   // @usuario
  bairro           String?
  cidade           String?
  estado           String?
  cep              String?
  habilitacao      String?   // Carro, Moto, Não possui
  tipoSanguineo    String?   // A+, O+, etc.
  peso             String?
  altura           String?
  manequim         String?
  sapato           String?
  saude            String?   // Alergias, restrições médicas, etc. (sensível)
  mei              String?
  nit              String?
  pagamentos       String?   // Histórico de pagamentos / cachês (sensível)
  historico        String?   // Histórico de atuações
  dataAdmissao     String?   // Data de admissão na companhia
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @default(now()) @updatedAt

  // Relação N:N com Peças (via tabela intermediária)
  pecas            PecaColaborador[]
  comprovantes     Comprovante[]

  @@map("colaboradores")
}

// =============================================================================
// Peça de teatro
// =============================================================================
model Peca {
  id           Int      @id @default(autoincrement())
  titulo       String
  resumo       String
  endereco     String   @default("") // Endereço principal/legado
  latitude     Float?   // Para o mapa Leaflet
  longitude    Float?   // Para o mapa Leaflet
  dataEstreia  String?  // Formato: "YYYY-MM-DD"
  status       String   @default("PROGRAMADA") // EM_CARTAZ | ENCERRADA | PROGRAMADA | EM_REPERTORIO | PROJETO_FUTURO
  linkIngresso String?  // Link externo para compra de ingresso (Sympla, Fever, etc.)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  // Relacionamentos
  fotos             FotoPeca[]
  colaboradores     PecaColaborador[]
  locais            LocalPeca[]
  downloadsTecnicos DownloadTecnico[]
  comprovantes      Comprovante[]

  @@map("pecas")
}

// =============================================================================
// Downloads Técnicos da Peça ("Press Kit" para Programadores e Contratantes)
// Rider técnico, projeto de encenação, dramaturgia, fotos em alta, clipping
// =============================================================================
model DownloadTecnico {
  id           Int      @id @default(autoincrement())
  pecaId       Int
  titulo       String   // Ex: "Rider Técnico", "Projeto de Encenação", "Dramaturgia"
  descricao    String?  // Ex: "Especificações de som, luz e palco"
  url          String   // Caminho do arquivo ou link externo
  tamanho      String?  // Ex: "3.2 MB"
  formato      String?  @default("PDF") // PDF | ZIP | DOCX | MP4
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  peca         Peca     @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  @@map("downloads_tecnicos")
}

// =============================================================================
// Formulário Público "Tem uma ideia?" / Propostas e Parcerias
// Mensagens enviadas por visitantes e programadores para a companhia
// =============================================================================
model MensagemIdeia {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String
  telefone      String?
  titulo        String?  // Título da ideia ou projeto
  descricao     String   // Descrição da proposta
  consentimento Boolean  @default(true) // Consentimento LGPD
  status        String   @default("NOVA") // NOVA | LIDA | RESPONDIDA | ARQUIVADA
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @default(now()) @updatedAt

  @@map("mensagens_ideias")
}

// =============================================================================
// Memória da Companhia (Linha do Tempo e Marcos Históricos)
// =============================================================================
model MemoriaItem {
  id           Int      @id @default(autoincrement())
  ano          String   // Ex: "2012", "2014–2017", "2017–2018", "2021–2024", "2024–2026"
  titulo       String   // Ex: "Os Contadores", "Francisco, do tempo em que se nascia bufão"
  categoria    String   @default("ESPETACULO") // ESPETACULO | PREMIO | FORMACAO | MARCO
  descricao    String   // Texto explicativo da obra ou marco
  local        String?  // Ex: "Centro de Artes UFF, Circuito SESC"
  imagemUrl    String?  // Foto de registro
  destaque     Boolean  @default(false)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@map("memoria_itens")
}

// =============================================================================
// Locais e Datas de Apresentação da Peça
// Permite que a mesma peça estreie em múltiplos teatros/cidades com datas próprias
// =============================================================================
model LocalPeca {
  id           Int      @id @default(autoincrement())
  pecaId       Int
  nomeLocal    String   // Ex: "Theatro Municipal de Niterói", "Teatro Riachuelo"
  cidade       String   // Ex: "Niterói, RJ", "Rio de Janeiro, RJ"
  endereco     String   // Ex: "Rua Quinze de Novembro, 35 - Centro"
  latitude     Float?   // Para o mapa Leaflet
  longitude    Float?   // Para o mapa Leaflet
  dataEstreia  String?  // "YYYY-MM-DD"
  dataFim      String?  // "YYYY-MM-DD" opcional
  horario      String?  // Ex: "Sexta e Sábado às 20h, Domingo às 18h"
  status       String   @default("PROGRAMADA") // EM_CARTAZ | ENCERRADA | PROGRAMADA | EM_REPERTORIO | PROJETO_FUTURO
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  peca         Peca     @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  @@map("locais_pecas")
}

// =============================================================================
// Tabela intermediária — Associação de colaboradores a peças
// Cada associação tem a função específica do colaborador naquela peça
// =============================================================================
model PecaColaborador {
  id             Int         @id @default(autoincrement())
  pecaId         Int
  colaboradorId  Int
  funcaoNaPeca   String      // Ex: "Ator Principal", "Figurinista", "Iluminação"
  criadoEm       DateTime    @default(now())
  atualizadoEm   DateTime    @default(now()) @updatedAt

  peca           Peca        @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@unique([pecaId, colaboradorId]) // Um colaborador só aparece uma vez por peça
  @@map("peca_colaboradores")
}

// =============================================================================
// Fotos e vídeos das peças
// =============================================================================
model FotoPeca {
  id           Int      @id @default(autoincrement())
  pecaId       Int
  url          String   // Caminho do arquivo
  descricao    String   @default("")
  tipo         String   @default("IMAGEM") // IMAGEM | VIDEO
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  peca         Peca     @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  @@map("fotos_pecas")
}

// =============================================================================
// Configurações customizáveis do site (editáveis pelo admin)
// =============================================================================
model ConfigSite {
  id           Int      @id @default(autoincrement())
  chave        String   @unique // Ex: "titulo_site", "propaganda_texto", "propaganda_imagem"
  valor        String
  tipo         String   @default("TEXT") // TEXT | IMAGE | HTML | VIDEO
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@map("config_site")
}

// =============================================================================
// Armazenamento Binário de Arquivos (Persistência no PostgreSQL do Render)
// Impede a perda de uploads em containers com filesystem efêmero
// =============================================================================
model Arquivo {
  id           Int      @id @default(autoincrement())
  nome         String   @unique // Ex: "arquivos-1724765432-123456.jpg"
  mimetype     String
  dados        Bytes
  tamanho      Int
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@map("arquivos")
}

// =============================================================================
// Propagandas / Anúncios do Site
// Publicadas e gerenciadas pelo admin; as 5 mais recentes aparecem na Home
// =============================================================================
model Propaganda {
  id           Int              @id @default(autoincrement())
  titulo       String
  descricao    String           // Texto da propaganda
  link         String?          // URL ou link de redirecionamento (ex: #contato, /pecas)
  textoBotao   String?          @default("Saiba Mais")
  ativo        Boolean          @default(true)
  ordem        Int              @default(0)
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @default(now()) @updatedAt

  // Fotos da propaganda (com exclusão em cascata)
  fotos        FotoPropaganda[]

  @@map("propagandas")
}

// =============================================================================
// Fotos das Propagandas
// =============================================================================
model FotoPropaganda {
  id           Int        @id @default(autoincrement())
  propagandaId Int
  url          String     // Caminho do arquivo /uploads/...
  ordem        Int        @default(0)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @default(now()) @updatedAt

  propaganda   Propaganda @relation(fields: [propagandaId], references: [id], onDelete: Cascade)

  @@map("fotos_propagandas")
}

// =============================================================================
// Comprovantes de Despesa e Prestação de Contas (Ata #01 e Ata #02)
// Recibos, notas fiscais, cachês e transporte com anexos PDF/imagens (admin only)
// =============================================================================
model Comprovante {
  id              Int          @id @default(autoincrement())
  titulo          String
  descricao       String?
  valor           Float
  dataComprovante String       // "YYYY-MM-DD"
  categoria       String       @default("OUTROS") // TRANSPORTE | ALIMENTACAO | CACHE | CENOGRAFIA_FIGURINO | DIVULGACAO | INFRAESTRUTURA | OUTROS
  arquivoUrl      String       // "/uploads/comprovante-..."
  arquivoNome     String?
  mimetype        String?
  tamanho         Int?

  pecaId          Int?
  peca            Peca?        @relation(fields: [pecaId], references: [id], onDelete: SetNull)

  colaboradorId   Int?
  colaborador     Colaborador? @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)

  extraidoPorIA   Boolean      @default(false)
  revisadoPor     String?

  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @default(now()) @updatedAt

  @@map("comprovantes")
}
